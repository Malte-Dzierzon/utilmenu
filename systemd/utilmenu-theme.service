[Unit]
Description=utilmenu live theming (resync Walker CSS + recolor icons)

[Service]
Type=oneshot
ExecStart=/bin/sh -c '%h/.config/utilmenu2/sync-style.sh; %h/.config/utilmenu2/recolor-icons.sh; %h/.config/utilmenu2/gen-menus.sh; /usr/bin/env PATH=%h/.local/bin:/run/current-system/sw/bin systemctl --user restart elephant'
